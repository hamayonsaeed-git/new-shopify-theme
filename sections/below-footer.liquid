{% comment %} sections/footer-copyright.liquid {% endcomment %}

<div class="footer-copyright">
  <div class="footer-copyright__inner page-width">
    <p class="footer-copyright__text">
      Copyright &copy; {{ 'now' | date: '%Y' }} {{ section.settings.company_name }}
    </p>
  </div>
</div>

<style>

/* Add to your theme's CSS */
.footer-copyright {
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_vertical }}px 0;
  text-align: center;
}

.footer-copyright__inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-copyright__text {

font-family: lucida;
font-size: 16.002px;
font-weight: 400;
line-height: 16.002px;
color: rgb(255, 255, 255);
margin: 0;
}


@media (max-width: 1200px) {
 .footer-copyright__text{
    font-size: 17.9935px;
 }
 .footer-copyright {
 
  padding: 18.38px 0;
  
}
}

@media (max-width: 1024px) {
 .footer-copyright__text{
    font-size: 11.9935px;
 }
 .footer-copyright {
 
  padding: 14.98px 0;
  
}
}
@media (max-width: 768px) {
 .footer-copyright__text{
    font-size: 12.4px;
 }
 .footer-copyright {
 
  padding: 15.48px 0;
  
}
}
</style>

{% schema %}
{
  "name": "Footer Copyright",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "company_name",
      "label": "Company Name",
      "default": "Mekhala Pte Ltd"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (px)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Footer Copyright"
    }
  ]
}
{% endschema %}